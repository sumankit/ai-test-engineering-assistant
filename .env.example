# --- LLM: leave as "mock" to run the entire pipeline offline with a
# deterministic stand-in, no API key required. Switch to groq or gemini
# for real agent reasoning. ---
LLM_PROVIDER=mock
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- MongoDB Atlas: job state, results, execution logs.
# Leave blank to use the local-JSON fallback at storage/mongo_fallback.json ---
MONGODB_URI=

MONGODB_DB=ai_test_engineering_assistant

# --- Supabase: original document storage.
# Leave blank to use the local-disk fallback at storage/originals/ ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=requirement-documents

# --- LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-test-engineering-assistant
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- SQLAlchemy: relational persistence for jobs, requirements, test
# cases, and traceability. Leave blank to default to SQLite at
# storage/app.db. Point at Supabase's Postgres connection string to use
# Supabase as the relational backend (Project Settings -> Database). ---
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

LOCAL_STORAGE_DIR=storage
